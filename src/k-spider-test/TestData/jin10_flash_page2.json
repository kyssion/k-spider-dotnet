[16121],"id":29}],"remark":[],"tags":[],"time":"2026-09-19 08:16:11","type":0,"voice_status":"ready","voices":null},{"channel":[1,2,3],"data":{"content":"<b>沙特民防部门表示，沙特首都利雅得的危险警报已解除。</b>","exclusive_to":[],"pic":"","source":"","source_link":"","title":""},"extras":{"ad":false},"id":"20260919081213679800","important":0,"kinds":[{"cids":[16161],"id":29},{"cids":[17992],"id":24},{"cids":[18754],"id":18458}],"remark":[],"tags":[],"time":"2026-09-19 08:12:13","type":0,"voice_status":"ready","voices":null},{"channel":[1,3],"data":{"content":"【消息人士：Anthropic首次公开募股或推迟至美国中期选举后】金十数据9月19日讯，据路透社报道，三位知情人士透露，在Anthropic即将进行IPO之前，且在该公司首席执行官呼吁全行业放缓步伐之后，其正考虑推出一款新的人工智能模型，以应对OpenAI自推出GPT-6Astra以来所形成的势头。OpenAI本月发布的GPT-6Astra在企业中获得了广泛关注，这引发了部分投资者的担忧。他们向路透表示，正在重新评估Anthropic作为企业级AI工具领先供应商的地位。一位知情人士称，Anthropic正在评估其下一代模型的安全性，作为是否发布该模型的考量之一。了解该公司思路的消息人士称，部分讨论涉及如何在新模型发布投资与提升公司盈利能力之间取得平衡，因为利率上升使得投资者更加关注预期利润的实现时间。另据两位知情人士透露，Anthropic可能会将首次公开募股（IPO）推迟至11月美国中期选举之后，预计选举不会对此次发行产生重大影响。此次IPO已较原计划推迟，路透此前曾报道称，路演最早预计将于10月中旬开始。","exclusive_to":[],"pic":"","source":"","source_link":"","title":""},"extras":{"ad":false},"id":"20260919080904084800","important":1,"kinds":[{"cids":[16121],"id":29},{"cids":[18681],"id":24},{"cids":[32,33],"id":31},{"cids":[17953,17958],"id":17952},{"cids":[17531,17532],"id":23}],"remark":[],"tags":[],"time":"2026-09-19 08:09:04","type":0,"voice_status":"ready","voices":null},{"channel":[1,2,3],"data":{"content":"<b>市场消息：沙特首都利雅得发布警报，警告存在敌对空中威胁。</b>","exclusive_to":[],"pic":"","source":"","source_link":"","title":""},"extras":{"ad":false},"id":"20260919080527767800","important":0,"kinds":[{"cids":[16161],"id":29},{"cids":[17992],"id":24},{"cids":[18754],"id":18458}],"remark":[],"tags":[],"time":"2026-09-19 08:05:27","type":0,"voice_status":"ready","voices":null},{"channel":[1,2,3],"data":{"content":"据路透社：Anthropic正考虑在IPO前推出一款新人工智能模型；Anthropic的首次公开募股可能会推迟到美国中期选举之后。","exclusive_to":[],"pic":"","source":"","source_link":"","title":""},"extras":{"ad":false},"id":"20260919080432327800","important":1,"kinds":[{"cids":[33],"id":31},{"cids":[17958],"id":17952},{"cids":[17531],"id":23},{"cids":[16121],"id":29},{"cids":[18681],"id":24}],"remark":[],"tags":[],"time":"2026-09-19 08:04:32","type":0,"voice_status":"ready","voices":null},{"channel":[1,2,3],"data":{"content":"沙特民防部门就海尔季（Al Kharj）潜在危险发布警报。","exclusive_to":[],"pic":"","source":"","source_link":"","title":""},"extras":{"ad":false},"id":"20260919080135562800","important":0,"kinds":[{"cids":[16161],"id":29},{"cids":[17992],"id":24},{"cids":[8348],"id":15},{"cids":[8348],"id":14}],"remark":[],"tags":[],"time":"2026-09-19 08:01:35","type":0,"voice_status":"ready","voices":null},{"channel":[1,2,3],"data":{"content":"【胡塞武装称沙特本周发动300次空袭】金十数据9月19日讯，也门胡塞武装发言人叶海亚·萨雷亚18日发表声明称，过去24小时，沙特阿拉伯战机对也门塔伊兹省发动了26次空袭。而本周，沙特战机对也门发动了300次空袭。沙特方面尚未就胡塞武装的说法作出回应。","exclusive_to":[],"pic":"","source":"央视新闻","source_link":"https://content-static.cctvnews.cctv.com/snow-book/index.html?item_id=3889457230723700854&channelId=1017&toc_style_id=feeds_default&module=ccnews%3A%2F%2Fappclient%2Fpage%2Ffeeds%2Fdetail%3Furl%3Dhttps%253A%252F%252Fcontent-static.cctvnews.cctv.com%252Fsnow-book%252Findex.html%253Fitem_id%253D3889457230723700854%2526channelId%253D1017%2526toc_style_id%253Dfeeds_default","title":""},"extras":{"ad":false},"id":"20260919075843656800","important":0,"kinds":[{"cids":[17992,18630,17991],"id":24},{"cids":[16280,16161,16110],"id":29},{"cids":[32],"id":31},{"cids":[18754],"id":18458}],"remark":[],"tags":[],"time":"2026-09-19 07:58:43","type":0,"voice_status":"ready","voices":null},{"channel":[1,3],"data":{"content":"【Gemini首次出现自主访问外部系统事件 谷歌称未造成实际损害】金十数据9月19日讯，谷歌表示，Gemini人工智能模型在一次网络安全能力测试中意外访问互联网，并进入3家公司系统，这是目前已知谷歌AI系统首次自主完成此类操作的案例。此次事件发生于5月，由安全公司Irregular开展测试。测试过程中，Gemini模型在一个“夺旗”网络安全演练中执行任务，但由于测试环境中的虚拟公司名称与真实公司相同，加上模型意外获得互联网访问权限，导致其进入真实企业系统。谷歌称，其中一次事件中，模型通过尝试密码进入受保护系统；另外两次则是在公开网络仓库中发现凭证并尝试访问相关系统。模型确认访问到真实公司系统后，均停止了后续操作。谷歌表示，该事件未对相关公司造成损害，因此未将其认定为模型失控事件，并称安全机制帮助模型及时停止行为。受影响公司已被通知，谷歌也向相关监管机构进行了通报。此次事件与OpenAI、Anthropic等AI公司此前披露的类似安全测试事件相似，再次引发外界对AI模型自主执行网络操作能力和安全防护机制的关注。","exclusive_to":[],"pic":"","source":"","source_link":"","title":""},"extras":{"ad":false},"id":"20260919061946164800","important":1,"kinds":[{"cids":[6354,6355],"id":16},{"cids":[17531,17532],"id":23},{"cids":[32],"id":31}],"remark":[{"content":"请升级版本查看该快讯注解","id":86546145,"title":"订阅人工智能动态","topic_id":397,"type":"topic"}],"tags":[],"time":"2026-09-19 06:19:46","type":0,"voice_status":"ready","voices":null}]}