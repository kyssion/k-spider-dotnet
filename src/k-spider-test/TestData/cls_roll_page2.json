0,"article_title":"","imgs":"","slogan":""},"depth_extends":"null","deny_comment":0,"level":"C","reading_num":527951,"content":"【欧盟首个规模化碳储存设施在丹麦启用】财联社9月18日电，丹麦18日在北海启用“绿沙”碳捕集与封存设施，将二氧化碳注入海底储层。作为欧盟境内首个规模化二氧化碳封存项目，“绿沙”第一阶段预计每年可封存40万吨二氧化碳。牵头该项目的英力士集团在官网发布声明说，二氧化碳将被封存于距丹麦西海岸约250公里的废弃油田尼尼韦斯特下方海底，深达海床之下约1800米。在第一阶段商业运营中，“绿沙”项目每年最多可封存40万吨二氧化碳。随着需求增长，封存能力计划到2030年扩大至每年400万至800万吨。 （央视新闻）","in_roll":1,"recommend":0,"confirmed":0,"jpush":0,"img":"","user_id":183,"is_top":0,"brief":"【欧盟首个规模化碳储存设施在丹麦启用】财联社9月18日电，丹麦18日在北海启用“绿沙”碳捕集与封存设施，将二氧化碳注入海底储层。作为欧盟境内首个规模化二氧化碳封存项目，“绿沙”第一阶段预计每年可封存40万吨二氧化碳。牵头该项目的英力士集团在官网发布声明说，二氧化碳将被封存于距丹麦西海岸约250公里的废弃油田尼尼韦斯特下方海底，深达海床之下约1800米。在第一阶段商业运营中，“绿沙”项目每年最多可封存40万吨二氧化碳。随着需求增长，封存能力计划到2030年扩大至每年400万至800万吨。","id":2487615,"ctime":1789745925,"type":-1,"title":"欧盟首个规模化碳储存设施在丹麦启用","bold":0,"sort_score":1789745925,"comment_num":0,"modified_time":1789745925,"status":1,"collection":0,"has_img":0,"category":"","shareurl":"https://api3.cls.cn/share/article/2487615?os=web\u0026sv=8.7.9\u0026app=CailianpressWeb","share_img":"https://img.cls.cn/share/roll.png","share_num":34,"sub_titles":[],"tags":[],"imgs":[],"images":[],"explain_num":-1,"stock_list":[],"is_ad":0,"ad":{"id":0,"title":"","img":"","url":"","monitorUrl":"","video_url":"","adTag":"","fullScreen":0,"type":0},"subjects":[{"article_id":2487615,"subject_id":1556,"subject_name":"环球市场情报","subject_img":"","subject_description":"","category_id":0,"attention_num":170192,"is_attention":false,"is_reporter_subject":false,"plate_id":0,"channel":"cls"}],"audio_url":["https://image.cls.cn/admin/20260918/233845sHafy11nHjQ8.mp3"],"author":"央视新闻","plate_list":[],"assocArticleUrl":"","assocVideoTitle":"","assocVideoUrl":"","assocCreditRating":[],"invest_calendar":{"id":0,"data_id":0,"r_id":"","type":0,"calendar_time":"","setting_time":"","event":null,"economic":null,"short_latents":null},"share_content":"","gray_share":0,"comment_recommand":null,"timeline":null,"is_fad":0,"disclaimer":""},{"author_extends":"","assocFastFact":{"f