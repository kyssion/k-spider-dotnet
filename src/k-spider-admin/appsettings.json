{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": ""
  },
  "Admin": {
    "Endpoints": {
      "BindAddress": "127.0.0.1",
      "RestPort": 5094,
      "GrpcPort": 5095
    },
    "Scheduler": {
      "TickSeconds": 5,
      "DefaultBatchLimit": 1000
    },
    "Reconciliation": {
      "TickSeconds": 10,
      "InactivityTimeoutSeconds": 300,
      "ProbeTimeoutSeconds": 5,
      "ProbeAttempts": 3,
      "ProbeWindowSeconds": 30,
      "MaxFailCount": 3,
      "ScanBatchSize": 100,
      "HeartbeatTimeoutSeconds": 30,
      "OfflineNodeRetentionMinutes": 10,
      "CleanupTickSeconds": 3600,
      "TerminalRetentionDays": 7,
      "CleanupBatchSize": 1000
    },
    "Grpc": {
      "SendTimeoutSeconds": 5,
      "ProbeTimeoutSeconds": 5
    }
  },
  "Auth": {
    "CookieName": "kspider.auth",
    "RememberMeDays": 7,
    "AllowedOrigins": []
  },
  "DataProtection": {
    "KeysPath": ""
  }
}
