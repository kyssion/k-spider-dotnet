<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>KSpider</RootNamespace>
        <!-- 目标环境 ( Development / Test / Production ) : 控制拷贝哪份环境配置 , 本地默认 Development ; 发布时如 dotnet publish -p:SpiderEnvironment=Production -->
        <SpiderEnvironment Condition="'$(SpiderEnvironment)' == ''">Development</SpiderEnvironment>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="HtmlAgilityPack" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Microsoft.Playwright" />
        <PackageReference Include="Quartz.Extensions.Hosting" />
        <PackageReference Include="SqlSugarCore" />
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    </ItemGroup>
    <ItemGroup>
        <!-- 基础配置 + 当前目标环境的配置文件 , 其余环境文件不进产物 ( 避免连接串互相泄漏 ) -->
        <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
        <None Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" Condition="'$(SpiderEnvironment)' == 'Development'" />
        <None Update="appsettings.Test.json" CopyToOutputDirectory="PreserveNewest" Condition="'$(SpiderEnvironment)' == 'Test'" />
        <None Update="appsettings.Production.json" CopyToOutputDirectory="PreserveNewest" Condition="'$(SpiderEnvironment)' == 'Production'" />
    </ItemGroup>
</Project>
