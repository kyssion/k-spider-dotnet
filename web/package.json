{
    "name": "k-spider-web",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "check:bundle": "node ./scripts/check-bundle-budget.mjs",
        "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build && pnpm run check:bundle",
        "test:e2e": "playwright test",
        "test:e2e:live": "playwright test -c playwright.live.config.ts"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.62.0",
        "clsx": "^2.1.1",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-router-dom": "^7.6.0",
        "recharts": "^3.1.0",
        "tailwind-merge": "^3.3.0",
        "zustand": "^5.0.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "1.63.0",
        "@tailwindcss/vite": "^4.1.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.3",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@vitejs/plugin-react": "^5.0.0",
        "eslint": "^10.14.0",
        "eslint-plugin-jsdoc": "^65.4.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.14.0",
        "jsdom": "^31.0.0",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.1.0",
        "typescript": "^5.8.0",
        "typescript-eslint": "^8.72.1",
        "vite": "^7.3.7",
        "vitest": "^5.1.0"
    }
}
