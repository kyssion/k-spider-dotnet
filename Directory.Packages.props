<Project>

    <!-- 中央包版本管理 : 各 csproj 的 PackageReference 只写包名不写版本 -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <!-- 传递依赖钉版 : 只提升有已知问题的传递依赖 , 不盲目升级主包 -->
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.10" />
        <PackageVersion Include="Npgsql" Version="9.0.3" />
        <!-- admin 数据访问：linq2db 提供映射与连接管理，条件更新/对账走裸 SQL（ADR 0011） -->
        <PackageVersion Include="linq2db" Version="6.5.1" />
    </ItemGroup>
    <ItemGroup>
        <!-- gRPC 契约 : proto 生成代码与运行时 ; 具体字段仍待确认（docs/10-architecture/distributed.md） -->
        <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
        <PackageVersion Include="Grpc.Core.Api" Version="2.85.0" />
        <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
        <!-- admin gRPC 服务端（ADR 0010） ; 客户端工厂不需要，避免多引依赖 -->
        <PackageVersion Include="Grpc.AspNetCore.Server" Version="2.85.0" />
    </ItemGroup>
    <ItemGroup>
        <!-- 测试项目 : v1 过渡测试与 v2 守卫共用 -->
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageVersion Include="MSTest.TestAdapter" Version="4.3.3" />
        <PackageVersion Include="MSTest.TestFramework" Version="4.3.3" />
    </ItemGroup>
    <ItemGroup>
        <!-- v1 归档项目 / 过渡测试所需的包版本 ; 随 v1 归档移除 -->
        <PackageVersion Include="HtmlAgilityPack" Version="1.12.4" />
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Playwright" Version="1.61.0" />
        <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.19.1" />
        <PackageVersion Include="SqlSugarCore" Version="5.1.4.216" />
        <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />

        <!--
          传递依赖钉版 : v1 测试依赖树中的已知漏洞。
          MySqlConnector < 2.6.1 (GHSA-473q-m89c-ghf8) ; System.Security.Cryptography.Pkcs 8.0.1
          命中 GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7。只提升传递依赖 , 不动主包。
        -->
        <PackageVersion Include="MySqlConnector" Version="2.6.1" />
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    </ItemGroup>
</Project>
